		  Amnesia/diagnosis/physiopathology/psychology, Cognition
		  Disorders/diagnosis/*physiopathology/psychology,
		  Handwriting, Practice, Psychological},
  pages		= {1203--12},
  annote	= {Yan, Jin HRountree, SusanMassman, PaulDoody, Rachelle
