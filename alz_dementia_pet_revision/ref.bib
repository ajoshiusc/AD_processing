  note		= {Edition: 2002/10/23},
  keywords	= {Adult, Female, Humans, Male, Psychomotor
		  Performance/*physiology, Aged, Aged, 80 and over,
		  Aging/*physiology, *Sex Characteristics,
		  Fingers/*physiology, Muscle Contraction/*physiology},
  pages		= {259--70},
  annote	= {Shinohara, MinoruLi, ShengKang, NingZatsiorsky, Vladimir
		  MLatash, Mark LengAG-18751/AG/NIA NIH HHS/M01
		  RR-10732/RR/NCRR NIH HHS/NS-35032/NS/NINDS NIH HHS/Research
		  Support, U.S. Gov't, P.H.S.J Appl Physiol (1985). 2003
		  Jan;94(1):259-70. doi: 10.1152/japplphysiol.00643.2002.
		  Epub 2002 Sep 13.}
}

@Article{	  smallfield_effectiveness_2017,
  title		= {Effectiveness of {Occupational} {Therapy} {Interventions}
		  to {Enhance} {Occupational} {Performance} for {Adults}
		  {With} {Alzheimer}'s {Disease} and {Related} {Major}
		  {Neurocognitive} {Disorders}: {A} {Systematic} {Review}},
  volume	= {71},
  issn		= {0272-9490 (Print) 0272-9490 (Linking)},
  url		= {https://www.ncbi.nlm.nih.gov/pubmed/28809651},
  doi		= {10.5014/ajot.2017.024752},
  abstract	= {OBJECTIVE: The purpose of this systematic review was to
		  describe the evidence for the effectiveness of
		  interventions designed to establish, modify, and maintain
		  occupations for adults with Alzheimer's disease (AD) and
		  related neurocognitive disorders. METHOD: Titles and
		  abstracts of 2,597 articles were reviewed, of which 256
		  were retrieved for full review and 52 met inclusion
		  criteria. U.S. Preventive Services Task Force levels of
		  certainty and grade definitions were used to describe the
		  strength of evidence. RESULTS: Articles were categorized
		  into five themes: occupation-based, sleep, cognitive,
		  physical exercise, and multicomponent interventions. Strong
		  evidence supports the benefits of occupation-based
		  interventions, physical exercise, and error-reduction
		  learning. CONCLUSION: Occupational therapy practitioners
		  should integrate daily occupations, physical exercise, and
		  error-reduction techniques into the daily routine of adults
		  with AD to enhance occupational performance and delay
		  functional decline. Future research should focus on
		  establishing consensus on types and dosage of exercise and
		  cognitive interventions.},
  number	= {5},
  journal	= {Am J Occup Ther},
  author	= {Smallfield, S. and Heckenlaible, C.},
  month		= sep,
  year		= {2017},
  note		= {Edition: 2017/08/16},
  keywords	= {Humans, Memory, Treatment Outcome, *Activities of Daily
		  Living, Alzheimer Disease/*rehabilitation, Cognitive
		  Remediation, Combined Modality Therapy, Exercise Therapy,
		  Neurocognitive Disorders/rehabilitation, Occupational
		  Therapy/*methods},
  pages		= {7105180010p1--7105180010p9},
  annote	= {Smallfield, StacyHeckenlaible, CindyengReviewSystematic
		  ReviewAm J Occup Ther. 2017
		  Sep/Oct;71(5):7105180010p1-7105180010p9. doi:
		  10.5014/ajot.2017.024752.}
}

@Article{	  smith_critical_1999,
  title		= {Critical decline in fine motor hand movements in human
		  aging},
  volume	= {53},
  issn		= {0028-3878 (Print) 0028-3878 (Linking)},
  url		= {https://www.ncbi.nlm.nih.gov/pubmed/10534251},
  doi		= {10.1212/wnl.53.7.1458},
  abstract	= {BACKGROUND: Slowing of motor movements in human aging is a
		  well-known occurrence, but its biologic basis is poorly
		  understood. Reliable quantitation may refine observations
		  of this phenomenon to better aid research on this entity.
		  METHODS: A panel equipped with timing sensors under
		  computer control was used to measure upper extremity
		  movement times in two groups of healthy individuals: adults
		  younger than 60 years of age (n = 56; range, 18-58 years)
		  and adults older than 60 years of age (n = 38; range, 61-94
		  years). RESULTS: Fine motor performance was better in the
		  dominant hand (p = 0.0007) regardless of age. Adult and
		  aged groups differed on two basic timing measures, which
		  reflect coarse motor and fine motor performance (p
		  {\textless} 0.0001). There were no gender differences on
		  either measure. There was a strong effect of task
		  difficulty with age on coarse motor (p {\textless} 0.01)
		  and fine motor (p {\textless} 0.0001) measures. The fine
		  motor measure of hand performance in healthy individuals
		  correlated in a nonlinear fashion with age for more
		  difficult tasks (r2 = 0.63) but showed a simple linear
		  relation for less-demanding tasks (r2 = 0.5). CONCLUSION:
		  This technique sensitively detects age-related motor
		  performance decline in humans. There may be a critical
		  period in late midlife when fine motor performance decline
		  either begins or abruptly worsens.},
  number	= {7},
  journal	= {Neurology},
  author	= {Smith, C. D. and Umberger, G. H. and Manning, E. L. and
		  Slevin, J. T. and Wekstein, D. R. and Schmitt, F. A. and
		  Markesbery, W. R. and Zhang, Z. and Gerhardt, G. A. and
		  Kryscio, R. J. and Gash, D. M.},
  month		= oct,
  year		= {1999},
  note		= {Edition: 1999/10/26},
  keywords	= {Adult, Female, Humans, Male, Movement/*physiology, Aged,
		  Aged, 80 and over, Middle Aged, Aging/*physiology,
		  Adolescent, Functional Laterality/*physiology,
		  Hand/*physiology, Regression Analysis},
  pages		= {1458--61},
  annote	= {Smith, C DUmberger, G HManning, E LSlevin, J TWekstein, D
		  RSchmitt, F AMarkesbery, W RZhang, ZGerhardt, G AKryscio, R
		  JGash, D MengAG05144/AG/NIA NIH HHS/AG06434/AG/NIA NIH
		  HHS/AG13494/AG/NIA NIH HHS/Research Support, U.S. Gov't,
		  P.H.S.Neurology. 1999 Oct 22;53(7):1458-61. doi:
		  10.1212/wnl.53.7.1458.}
}

@Article{	  smith_aging_1999,
  title		= {Aging, motor control, and the performance of computer
		  mouse tasks},
  volume	= {41},
  issn		= {0018-7208 (Print) 0018-7208 (Linking)},
  url		= {https://www.ncbi.nlm.nih.gov/pubmed/10665207},
  doi		= {10.1518/001872099779611102},
  abstract	= {Because of the increased presence of computers in work and
		  everyday life and the demographic "graying" of America,
		  there is a need for interface designs that promote
		  accessibility for older people. This study examined age
		  differences in the performance of basic computer mouse
		  control techniques. An additional goal of the study was to
		  examine the influence of age-related changes in psychomotor
		  abilities on mouse control. A total of 60 participants in 3
		  age groups (20-39 years, 40-59 years, and 60-75 years)
		  performed 4 target acquisition tasks (pointing, clicking,
		  double-clicking, and dragging) using a computer mouse. The
		  data indicated that the older participants had more
		  difficulty performing mouse tasks than the younger
		  participants. Differences in performance attributable to
		  age were found for the more complex tasks (clicking and
		  double-clicking). Furthermore, age-related changes in
		  psychomotor abilities were related to age differences in
		  performance. We discuss applications to computer interface
		  designs. Actual or potential applications of this research
		  include specifications for computer mouse design to
		  accommodate older populations.},
  number	= {3},
  journal	= {Hum Factors},
  author	= {Smith, M. W. and Sharit, J. and Czaja, S. J.},
  month		= sep,
  year		= {1999},
  note		= {Edition: 2000/02/09},
  keywords	= {Adult, Analysis of Variance, Female, Humans, Male, Aged,
		  Middle Aged, *Task Performance and Analysis, Age Factors,
		  *Aging, *Psychomotor Performance, *Computer Peripherals,
		  User-Computer Interface},
  pages		= {389--96},
  annote	= {Smith, M WSharit, JCzaja, S JengAG11748-05/AG/NIA NIH
		  HHS/Comparative StudyResearch Support, U.S. Gov't,
		  P.H.S.Hum Factors. 1999 Sep;41(3):389-96. doi:
		  10.1518/001872099779611102.}
}

@Article{	  sperling_toward_2011,
  title		= {Toward defining the preclinical stages of {Alzheimer}'s
		  disease: recommendations from the {National} {Institute} on
		  {Aging}-{Alzheimer}'s {Association} workgroups on
		  diagnostic guidelines for {Alzheimer}'s disease},
  volume	= {7},
  issn		= {1552-5279 (Electronic) 1552-5260 (Linking)},
  url		= {https://www.ncbi.nlm.nih.gov/pubmed/21514248},
  doi		= {10.1016/j.jalz.2011.03.003},
  abstract	= {The pathophysiological process of Alzheimer's disease (AD)
		  is thought to begin many years before the diagnosis of AD
		  dementia. This long "preclinical" phase of AD would provide
		  a critical opportunity for therapeutic intervention;
		  however, we need to further elucidate the link between the
		  pathological cascade of AD and the emergence of clinical
		  symptoms. The National Institute on Aging and the
		  Alzheimer's Association convened an international workgroup
		  to review the biomarker, epidemiological, and
		  neuropsychological evidence, and to develop recommendations
		  to determine the factors which best predict the risk of
		  progression from "normal" cognition to mild cognitive
		  impairment and AD dementia. We propose a conceptual
		  framework and operational research criteria, based on the
		  prevailing scientific evidence to date, to test and refine
		  these models with longitudinal clinical research studies.
		  These recommendations are solely intended for research
		  purposes and do not have any clinical implications at this
		  time. It is hoped that these recommendations will provide a
		  common rubric to advance the study of preclinical AD, and
		  ultimately, aid the field in moving toward earlier
		  intervention at a stage of AD when some disease-modifying
		  therapies may be most efficacious.},
  number	= {3},
  journal	= {Alzheimers Dement},
  author	= {Sperling, R. A. and Aisen, P. S. and Beckett, L. A. and
